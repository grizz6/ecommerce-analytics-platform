[sqlfluff]
# Shared rules. Plain SQL (the Snowflake setup scripts) uses the Snowflake
# dialect; transform/.sqlfluff switches dbt models to the dbt templater.
dialect = snowflake
templater = jinja
max_line_length = 100
large_file_skip_byte_limit = 50000

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

[sqlfluff:templater:dbt]
# Used only when linting dbt models with --templater dbt (see the Makefile).
project_dir = ./transform
profiles_dir = ./transform/ci
profile = ecommerce_analytics
target = ci

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = False
indented_using_on = True

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:references.keywords]
# GA4 export column names that are also SQL keywords. They must keep the
# source names so loading can match columns by name.
ignore_words = platform,geo

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = explicit

[sqlfluff:rules:convention.terminator]
multiline_newline = False
require_final_semicolon = False
