# Copy this file to .env and fill in values locally. Never commit .env.
# Every value is intentionally empty here.

# Logging
LOG_LEVEL=

# BigQuery extraction (Application Default Credentials, no key files)
GCP_PROJECT_ID=
BQ_MAX_BYTES_PER_QUERY=
BQ_MAX_BYTES_PER_RUN=
GA4_START_DATE=
GA4_END_DATE=
RAW_DATA_DIR=

# Snowflake: shared settings
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_RAW_DATABASE=
SNOWFLAKE_ANALYTICS_DATABASE=

# Snowflake: loader service user (role LOADER)
SNOWFLAKE_LOADER_USER=
SNOWFLAKE_LOADER_ROLE=
SNOWFLAKE_LOADER_WAREHOUSE=
SNOWFLAKE_LOADER_PRIVATE_KEY_PATH=
SNOWFLAKE_LOADER_PRIVATE_KEY_PASSPHRASE=

# Snowflake: dbt service user (role TRANSFORMER)
SNOWFLAKE_DBT_USER=
SNOWFLAKE_DBT_ROLE=
SNOWFLAKE_DBT_WAREHOUSE=
SNOWFLAKE_DBT_SCHEMA=
SNOWFLAKE_DBT_PRIVATE_KEY_PATH=
SNOWFLAKE_DBT_PRIVATE_KEY_PASSPHRASE=

# dbt on DuckDB
DBT_DUCKDB_PATH=
